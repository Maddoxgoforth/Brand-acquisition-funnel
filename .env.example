# Copy this file to .env.local for local development, and set the same
# variables in your Vercel project's Environment Variables settings for
# production. Never commit .env.local — it's gitignored.

# OpenAI — used by src/app/api/content-audit/route.ts to generate each
# visitor's personalized game plan (niche, video ideas, product ideas).
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: override the model used for game-plan generation. Defaults to
# gpt-4o-mini if unset. Verify the current recommended model name in your
# OpenAI dashboard/docs before relying on the default long-term — model
# availability changes over time.
OPENAI_MODEL=

# ConvertKit (Kit) — used to upsert the lead as a subscriber with custom
# fields and subscribe them to a form, which triggers your email automation.
# Get an API key at Kit > Account Settings > Developer.
CONVERTKIT_API_KEY=

# The numeric ID of the Kit Form the content-audit lead gets subscribed to.
# Find it in Kit > Grow > Landing Pages & Forms > (your form) > Settings.
CONVERTKIT_FORM_ID=

# Optional: a Zapier "Webhooks by Zapier" Catch Hook URL. When set, every
# content-audit submission (lead info + quiz answers + generated game plan)
# is POSTed here as JSON, letting a Zap forward it anywhere (e.g. a Discord
# channel notification). If unset, this step is silently skipped — it never
# blocks or fails the visitor's game-plan delivery either way.
ZAPIER_CONTENT_AUDIT_WEBHOOK_URL=

# Optional: a Discord "Incoming Webhook" URL for the /free-course lead form
# (src/app/api/free-course-lead/route.ts). When set, every submission (name,
# email, phone) is posted directly to this Discord channel as an embed — no
# Zapier needed. Create one in Discord: Channel Settings > Integrations >
# Webhooks > New Webhook > Copy Webhook URL. If unset, this step is silently
# skipped and the lead form still works, it just doesn't notify anyone.
DISCORD_FREE_COURSE_WEBHOOK_URL=

# Optional: a Slack "Incoming Webhook" URL. When set, every free-course lead
# (name, phone, email) is also posted to that Slack channel with a link to
# the CRM. Create one at api.slack.com/apps > your app > Incoming Webhooks.
# If unset, this step is silently skipped.
SLACK_FREE_COURSE_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Private CRM (/crm) — see "CRM setup" in CLAUDE.md
# ---------------------------------------------------------------------------

# Postgres connection string for the CRM's leads. Adding a Neon database from
# the Vercel project's Storage tab sets this for you in production. Leave it
# unset locally and `npm run dev` uses a throwaway embedded database in
# ./.crm-dev-db instead.
DATABASE_URL=

# The owner's password for /crm/login ("Owner sign in"), and a long random
# string (16+ characters) used to sign login cookies. The CRM stays locked
# until both are set. Team members don't use this password: they create
# their own account at /crm/signup and the owner approves it. Changing
# CRM_SESSION_SECRET signs everyone out.
CRM_PASSWORD=
CRM_SESSION_SECRET=

# Optional: lets outside tools (Zapier, Typeform, scripts) push leads in via
# POST /api/crm/webhook. Send it as the x-crm-secret header. The site's own
# free-course form does not need this.
CRM_WEBHOOK_SECRET=

# Twilio — powers the Call button in the CRM (browser calling). All six are
# required; until they're set the Call button shows which ones are missing.
# Account SID + Auth Token: Twilio Console home > Account Info.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# A Standard API key: Twilio Console > Account > API keys & tokens.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# The TwiML App whose Voice Request URL points at /api/crm/twilio/voice.
TWILIO_TWIML_APP_SID=
# Your Twilio number, shown as caller ID. E.164 format, e.g. +15551234567.
TWILIO_PHONE_NUMBER=

# Meta (Facebook/Instagram) ads tracking. Everything here is optional: with
# nothing set, no Pixel loads and no conversions are sent.
# Pixel id from Events Manager (a number, not secret). Loads the Pixel on the
# public pages (never /crm). Needs a redeploy after changing (it's built in).
NEXT_PUBLIC_META_PIXEL_ID=
# Conversions API token: Events Manager > your Pixel > Settings > Generate
# access token. Secret. Sends Lead / Schedule / Purchase from the server.
META_CAPI_TOKEN=
# Optional: test code from Events Manager > Test events, to check events
# arrive. Remove it before running real ads.
META_TEST_EVENT_CODE=
# Optional: value sent with the Purchase event when a lead moves to Closed
# (USD). Defaults to 1000 (the mid-ticket price).
META_PURCHASE_VALUE=
# Optional: domain verification code (Business settings > Brand safety >
# Domains > meta-tag method). Adds <meta name="facebook-domain-verification">.
NEXT_PUBLIC_META_DOMAIN_VERIFICATION=

# TikTok ads tracking. Optional: with nothing set, no TikTok pixel loads.
# Pixel id from TikTok Events Manager (not secret). Already defaults to the
# Mad Media LLC pixel (DBFUQ5BC77UASCMGN6O0); set this only to override it.
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
# Events API access token: Events Manager > your pixel > Settings >
# Generate access token. Secret. Sends SubmitForm / Schedule / Purchase.
TIKTOK_EVENTS_TOKEN=
# Optional: test code from Events Manager > Test events. Remove before ads.
TIKTOK_TEST_EVENT_CODE=

# Closes: when a lead is marked Closed (with its plan and payment screenshot),
# the CRM posts name, phone, plan, amount and a screenshot link here. The Zapier
# workflow "CRM close → #successful-payments" posts it to Discord.
ZAPIER_CLOSE_WEBHOOK_URL=
